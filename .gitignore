# Dependencies
node_modules/

# Build output
dist/
build/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env files
.env
.env.local
.env.*.local

# DB credentials (never commit real MySQL creds)
backend/db_credentials.php

# Local admin credentials (production uses env vars)
backend/admin_config.php

# Deployment zip
backend/backend.zip

# Logs
*.log
npm-debug.log*

# Database (never commit user data)
*.sqlite
*.sqlite3
*.db

# User-uploaded files (keep the folder, ignore contents)
backend/upload/*
!backend/upload/.gitkeep
# Allow the seed car images to be committed
!backend/upload/*_car*.jpg
!backend/upload/*_car*.jpeg
!backend/upload/*_car*.png
!backend/upload/*_car*.avif
!backend/upload/*_testCar*.jpg
